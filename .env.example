# cp .env.example .env して値を埋める。.env は gitignore 済み。

# Cloudflare ダッシュボードの Workers & Pages の右側に出ている
CLOUDFLARE_ACCOUNT_ID=
# 「Workers スクリプト:編集」の権限のトークン
CLOUDFLARE_API_TOKEN=

# Worker 名を変えるとき（既定は essais）
# ESSAIS_WORKER_NAME=essais

# 原稿（src/posts/）の写しを取る R2 のバケット。公開していないバケットにする。無ければ写しは取らない
ESSAIS_R2_BACKUP_BUCKET=
# R2 のトークンを公開用と分けるとき（無ければ CLOUDFLARE_API_TOKEN を使う）
# ESSAIS_R2_TOKEN=
